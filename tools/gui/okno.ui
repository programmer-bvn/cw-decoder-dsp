<?xml version="1.0" encoding="UTF-8"?>
<!--
  Okno Dekodera CW (Qt6 / PySide6) — 08.11.2026.
  Układ i wygląd ustawia operator w Qt Designerze (tools\gui\designer.bat).
  Kod szuka elementów PO NAZWIE (objectName) — nazw nie zmieniać; wolno
  przesuwać, zmieniać rozmiary, kolory, czcionki, kolejność w układach.
  Ramki „ramka*" to miejsca na rysowane elementy (S-metr, miernik tonu,
  widok sygnału): kod wstawia w nie swój widżet na całą ramkę.
  ramkaWidokSygnalu (od 08.11) — jeden komponent zamiast trzech wodospadów
  i paska P: rośnie razem z oknem (verstretch 3 : 1 względem tekstu).
-->
<ui version="4.0">
 <class>OknoDekodera</class>
 <widget class="QMainWindow" name="OknoDekodera">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1100</width><height>820</height></rect></property>
  <property name="windowTitle"><string>Dekoder CW SQ2BVN</string></property>
  <widget class="QWidget" name="centralny">
   <layout class="QVBoxLayout" name="ukladGlowny">
    <property name="spacing"><number>6</number></property>

    <!-- pasek górny: stan + przyciski -->
    <item>
     <layout class="QHBoxLayout" name="ukladGora">
      <item><widget class="QLabel" name="lblStan"><property name="text"><string>Start…</string></property></widget></item>
      <item><spacer name="odstepGora"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
      <item><widget class="QLabel" name="lblWersja"><property name="text"><string>nowa wersja</string></property></widget></item>
      <item><widget class="QPushButton" name="btnWyczysc"><property name="text"><string>Wyczyść</string></property></widget></item>
      <item><widget class="QPushButton" name="btnOtworz"><property name="text"><string>Otwórz plik…</string></property></widget></item>
      <item><widget class="QPushButton" name="btnRadio"><property name="text"><string>Wróć do radia</string></property></widget></item>
      <item><widget class="QLabel" name="lblTempo"><property name="text"><string>tempo</string></property></widget></item>
      <item>
       <widget class="QComboBox" name="cmbTempo">
        <item><property name="text"><string>1×</string></property></item>
        <item><property name="text"><string>2×</string></property></item>
        <item><property name="text"><string>4×</string></property></item>
        <item><property name="text"><string>max</string></property></item>
       </widget>
      </item>
      <item><widget class="QPushButton" name="btnZglos"><property name="text"><string>Zgłoś problem</string></property></widget></item>
     </layout>
    </item>

    <!-- pasek pomiarów: ton nad szumem + próg blokady, S-metr, raport RST -->
    <item>
     <layout class="QHBoxLayout" name="ukladPomiary">
      <item>
       <layout class="QVBoxLayout" name="ukladTon">
        <item><widget class="QLabel" name="lblTonNadSzumem"><property name="text"><string>ton nad szumem</string></property></widget></item>
        <item>
         <widget class="QFrame" name="ramkaMiernikTonu">
          <property name="minimumSize"><size><width>220</width><height>16</height></size></property>
          <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="ukladProg">
          <item><widget class="QLabel" name="lblProg"><property name="text"><string>próg blokady</string></property></widget></item>
          <item>
           <widget class="QSlider" name="sldProg">
            <property name="minimum"><number>0</number></property>
            <property name="maximum"><number>30</number></property>
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
           </widget>
          </item>
          <item><widget class="QLabel" name="lblProgWartosc"><property name="text"><string>0 dB</string></property></widget></item>
         </layout>
        </item>
       </layout>
      </item>
      <item><spacer name="odstepPomiary"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
      <item>
       <layout class="QVBoxLayout" name="ukladSmetr">
        <item><widget class="QLabel" name="lblSmetr"><property name="text"><string>S-metr</string></property></widget></item>
        <item>
         <widget class="QFrame" name="ramkaSmetr">
          <property name="minimumSize"><size><width>240</width><height>28</height></size></property>
          <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QVBoxLayout" name="ukladRaport">
        <item><widget class="QLabel" name="lblRaport"><property name="text"><string>raport</string></property></widget></item>
        <item>
         <layout class="QHBoxLayout" name="ukladRST">
          <item><widget class="QLabel" name="lblR"><property name="text"><string>–</string></property></widget></item>
          <item><widget class="QLabel" name="lblS"><property name="text"><string>–</string></property></widget></item>
          <item><widget class="QLabel" name="lblT"><property name="text"><string>–</string></property></widget></item>
         </layout>
        </item>
        <item><widget class="QLabel" name="lblRaportOpis"><property name="text"><string/></property></widget></item>
       </layout>
      </item>
     </layout>
    </item>

    <!-- widok sygnału: lupa i nakładki analizy -->
    <item>
     <layout class="QHBoxLayout" name="ukladLupa">
      <item><widget class="QLabel" name="lblLupa"><property name="text"><string>lupa</string></property></widget></item>
      <item>
       <widget class="QSlider" name="sldLupa">
        <property name="toolTip"><string>Ile czasu mieści się na ekranie (też kółko myszy na wykresie)</string></property>
        <property name="minimum"><number>0</number></property>
        <property name="maximum"><number>100</number></property>
        <property name="orientation"><enum>Qt::Horizontal</enum></property>
       </widget>
      </item>
      <item><widget class="QLabel" name="lblLupaWartosc"><property name="text"><string>4 s</string></property></widget></item>
      <item><widget class="QCheckBox" name="chkZbocza"><property name="text"><string>zbocza po regeneracji</string></property><property name="checked"><bool>true</bool></property></widget></item>
      <item><widget class="QCheckBox" name="chkGrzebien"><property name="text"><string>grzebień</string></property><property name="checked"><bool>true</bool></property></widget></item>
      <item><widget class="QCheckBox" name="chkKursory"><property name="text"><string>kursory</string></property><property name="toolTip"><string>Dwa kursory czasu (A, B) na każdym pasie, na każdym dwie kropki: poziom w % i częstotliwość</string></property></widget></item>
      <item><widget class="QCheckBox" name="chkPrzyciagaj"><property name="text"><string>przyciągaj do linii</string></property><property name="checked"><bool>true</bool></property></widget></item>
      <item>
       <widget class="QToolButton" name="btnPasy">
        <property name="text"><string>pasy ▾</string></property>
        <property name="toolTip"><string>Które pasy widać (wybór zapamiętany)</string></property>
        <property name="popupMode"><enum>QToolButton::InstantPopup</enum></property>
       </widget>
      </item>
      <item><spacer name="odstepLupa"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
      <item><widget class="QPushButton" name="btnNaZywo"><property name="text"><string>na żywo</string></property><property name="checkable"><bool>true</bool></property><property name="checked"><bool>true</bool></property></widget></item>
     </layout>
    </item>

    <!-- jeden komponent: wejście, po obróbce, oczami sieci, P(klucz) na wspólnej osi czasu -->
    <item>
     <widget class="QFrame" name="ramkaWidokSygnalu">
      <property name="minimumSize"><size><width>600</width><height>240</height></size></property>
      <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
      <property name="sizePolicy"><sizepolicy hsizetype="Expanding" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>3</verstretch></sizepolicy></property>
     </widget>
    </item>

    <!-- odczytany tekst: zaznaczanie i kopiowanie (Ctrl+C) działa, pisać się nie da -->
    <item>
     <widget class="QTextEdit" name="txtOdczyt">
      <property name="readOnly"><bool>true</bool></property>
      <property name="textInteractionFlags"><set>Qt::TextSelectableByKeyboard|Qt::TextSelectableByMouse</set></property>
      <property name="sizePolicy"><sizepolicy hsizetype="Expanding" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>1</verstretch></sizepolicy></property>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QStatusBar" name="pasekStanu"/>
 </widget>
 <resources/>
 <connections/>
</ui>
