      <item>
       <layout class="QVBoxLayout" name="ukladPasekTekstu">
        <item><widget class="QToolButton" name="btnCzcionkaWieksza"><property name="minimumSize"><size><width>76</width><height>26</height></size></property><property name="text"><string>A+</string></property><property name="toolTip"><string>Większa czcionka (też Ctrl + kółko)</string></property></widget></item>
        <item><widget class="QToolButton" name="btnCzcionkaMniejsza"><property name="minimumSize"><size><width>76</width><height>26</height></size></property><property name="text"><string>A−</string></property><property name="toolTip"><string>Mniejsza czcionka</string></property></widget></item>
        <item><widget class="QToolButton" name="btnWyczysc"><property name="minimumSize"><size><width>76</width><height>26</height></size></property><property name="text"><string>Wyczyść</string></property><property name="toolTip"><string>Wyczyść bufor tekstu</string></property></widget></item>
        <item><widget class="QToolButton" name="btnKopiuj"><property name="minimumSize"><size><width>76</width><height>26</height></size></property><property name="text"><string>Kopiuj</string></property><property name="toolTip"><string>Do schowka: zaznaczenie, a bez zaznaczenia cały tekst</string></property></widget></item>
        <item><widget class="QToolButton" name="btnZapisz"><property name="minimumSize"><size><width>76</width><height>26</height></size></property><property name="text"><string>Zapisz…</string></property><property name="toolTip"><string>Do pliku: HTML z kolorami (otwiera każda przeglądarka i Word) albo zwykły tekst</string></property></widget></item>
        <item><spacer name="odstepPasekTekstu"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
       </layout>
      </item>
      <item>
       <widget class="QTextEdit" name="txtOdczyt">
        <property name="readOnly"><bool>true</bool></property>
        <property name="textInteractionFlags"><set>Qt::TextSelectableByKeyboard|Qt::TextSelectableByMouse</set></property>
        <property name="sizePolicy"><sizepolicy hsizetype="Expanding" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>1</verstretch></sizepolicy></property>
       </widget>
      </item>
     </layout>
    </item>
   </layout>
      </widget>
