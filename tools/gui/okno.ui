    <item>
     <!-- zakładki (operator 08.11): „Odbiór" — praca, „Ustawienia" — zamiast okienka startowego -->
     <widget class="QTabWidget" name="zakladki">
      <widget class="QWidget" name="zakOdbior">
       <attribute name="title"><string>Odbiór</string></attribute>
   <layout class="QVBoxLayout" name="ukladGlowny">
    <property name="spacing"><number>6</number></property>

    <!-- pasek górny: stan + przyciski -->
